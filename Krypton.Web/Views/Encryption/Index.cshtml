@model EncryptFileViewModel
@{
    ViewData["Title"] = "Criptografar arquivos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3" data-enter>
    <div>
        <h1 class="h3 fw-bold mb-1">Criptografar arquivos</h1>
        <p class="text-body-secondary mb-0">
            Selecione os arquivos e defina uma senha para selar em um pacote autenticado <code>.krypt</code> (AES-256-GCM).
        </p>
    </div>

    <div class="workspace-switcher" role="navigation" aria-label="Alternar modo de operação">
        <a asp-controller="Encryption" asp-action="Index" class="workspace-switcher-tab active-encrypt" aria-current="page">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            <span>Criptografar</span>
        </a>
        <a asp-controller="Decryption" asp-action="Index" class="workspace-switcher-tab">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 7.4-2" />
            </svg>
            <span>Descriptografar</span>
        </a>
    </div>
</div>

<form id="encryptForm" asp-controller="Encryption" asp-action="Encrypt" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <!-- Coluna 1: Seleção de Arquivos e Opções -->
        <div class="col-lg-7">
            <div class="card krypton-card mb-4">
                <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Arquivos de entrada</span>
                    <span class="badge bg-transparent border border-secondary border-opacity-50 text-body-secondary font-monospace tabular-nums" id="selectedFilesCounter" aria-live="polite">0 arquivos</span>
                </div>
                <div class="card-body p-4">
                    <div id="encryptDropzone" class="krypton-dropzone p-4 p-md-5 text-center mb-3" role="button" tabindex="0" aria-label="Área para arrastar arquivos ou clicar para selecionar no computador">
                        <input type="file" id="encryptFileInput" name="Files" multiple class="d-none" required />
                        <div class="dropzone-icon-box" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0l-4 4m4-4l4 4" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 16.7A4.5 4.5 0 0 0 17.5 8h-1.1A7 7 0 1 0 4 14.9" />
                            </svg>
                        </div>
                        <h2 class="h5 fw-bold mb-1">Solte os arquivos aqui ou escolha no computador</h2>
                        <p class="small text-body-secondary mx-auto mb-3">
                            Documentos, imagens, planilhas ou pacotes — até 50 arquivos por lote (máx. 500 MB)
                        </p>
                        <button type="button" class="btn btn-sm btn-outline-secondary touch-target-btn px-4 fw-semibold" id="browseEncryptFilesBtn">
                            Selecionar arquivos
                        </button>
                    </div>

                    <div id="selectedFilesContainer" class="d-none">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-body-secondary">Fila de selagem</span>
                            <button type="button" id="clearSelectedFilesBtn" class="btn btn-link btn-sm text-danger p-0 text-decoration-none">
                                Limpar fila
                            </button>
                        </div>
                        <ul class="list-group list-group-flush border rounded-3 mb-3" id="selectedFilesList"></ul>
                    </div>

                    <!-- Seletor de Modo em Lote (Exibido automaticamente quando > 1 arquivo for selecionado) -->
                    <fieldset id="batchOptionsPanel" class="p-3 rounded-3 border border-secondary border-opacity-25 d-none">
                        <legend class="h6 fw-bold mb-2">Empacotamento dos múltiplos arquivos</legend>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="BatchMode" id="batchModeVault"
                                   value="@((int)BatchEncryptionMode.SingleEncryptedVault)" checked />
                            <label class="form-check-label small" for="batchModeVault">
                                <strong>Cofre único (<code>.krypt</code>):</strong> Agrupa todos os arquivos em um container interno e gera um único arquivo <code>.krypt</code>.
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="BatchMode" id="batchModeIndividual"
                                   value="@((int)BatchEncryptionMode.IndividualKryptFiles)" />
                            <label class="form-check-label small" for="batchModeIndividual">
                                <strong>Arquivos separados (<code>.zip</code>):</strong> Criptografa cada arquivo individualmente e entrega todos dentro de um pacote <code>.zip</code>.
                            </label>
                        </div>
                    </fieldset>
                </div>
            </div>

            <!-- Opções Adicionais -->
            <div class="card krypton-card">
                <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Parâmetros de saída</span>
                    <span class="font-monospace small text-body-secondary">AES-256-GCM / PBKDF2-SHA512</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="CompressBeforeEncrypt" id="compressSwitch" />
                                <label class="form-check-label small" for="compressSwitch">
                                    <strong>Compactar antes de criptografar</strong>
                                    <span class="d-block text-body-secondary">Aplica compressão GZip em fluxo antes da cifra</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="ObfuscateOutputFileName" id="obfuscateSwitch" />
                                <label class="form-check-label small" for="obfuscateSwitch">
                                    <strong>Ocultar nome externo</strong>
                                    <span class="d-block text-body-secondary">Renomeia a saída para <code>vault-a1b2c3d4.krypt</code></span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Coluna 2: Senha e Execução -->
        <div class="col-lg-5">
            <div class="card krypton-card mb-4">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="fw-bold">Senha de proteção</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label for="encryptPassword" class="form-label small fw-semibold">Senha do cofre (mínimo de 8 caracteres)</label>
                        <div class="input-group">
                            <input type="password" asp-for="Password" id="encryptPassword" class="form-control font-monospace"
                                   placeholder="Digite a senha..." autocomplete="new-password" aria-describedby="passwordStrengthText" required />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn touch-target-btn" data-target="encryptPassword" aria-label="Mostrar ou ocultar senha">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-body-secondary">Comprimento da senha</span>
                            <span id="passwordStrengthText" class="text-body-secondary tabular-nums">Mínimo de 8 caracteres</span>
                        </div>
                        <div class="progress" style="height: 5px;">
                            <div id="passwordStrengthBar" class="progress-bar bg-secondary" role="progressbar" style="width: 0%" aria-hidden="true"></div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label for="confirmEncryptPassword" class="form-label small fw-semibold">Confirme a senha</label>
                        <div class="input-group">
                            <input type="password" asp-for="ConfirmPassword" id="confirmEncryptPassword" class="form-control font-monospace"
                                   placeholder="Repita a mesma senha..." autocomplete="new-password" aria-describedby="passwordMatchFeedback" required />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn touch-target-btn" data-target="confirmEncryptPassword" aria-label="Mostrar ou ocultar confirmação de senha">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div id="passwordMatchFeedback" class="form-text small mt-1" aria-live="polite"></div>
                    </div>
                </div>
            </div>

            <div id="encryptAlertContainer" role="region" aria-live="polite"></div>

            <div id="encryptProgressCard" class="card krypton-card mb-3 d-none">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between small fw-semibold mb-2">
                        <span>Derivando chave (600.000 iter) e selando blocos...</span>
                        <span class="font-monospace">Processando</span>
                    </div>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <button type="submit" id="submitEncryptBtn" class="btn-krypton-primary w-100 py-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                </svg>
                <span>Criptografar e baixar .krypt</span>
            </button>
        </div>
    </div>
</form>
