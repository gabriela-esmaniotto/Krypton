@model DecryptFileViewModel
@{
    ViewData["Title"] = "Descriptografar arquivo";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3" data-enter>
    <div>
        <h1 class="h3 fw-bold mb-1">Descriptografar arquivo</h1>
        <p class="text-body-secondary mb-0">
            Envie um arquivo <code>.krypt</code> e informe a senha para validar a autenticidade AES-256-GCM e restaurar o arquivo original.
        </p>
    </div>

    <div class="workspace-switcher" role="navigation" aria-label="Alternar modo de operação">
        <a asp-controller="Encryption" asp-action="Index" class="workspace-switcher-tab">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
            <span>Criptografar</span>
        </a>
        <a asp-controller="Decryption" asp-action="Index" class="workspace-switcher-tab active-decrypt" aria-current="page">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 7.4-2" />
            </svg>
            <span>Descriptografar</span>
        </a>
    </div>
</div>

<form id="decryptForm" asp-controller="Decryption" asp-action="Decrypt" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card krypton-card h-100">
                <div class="card-header bg-transparent border-bottom py-3 px-4 d-flex align-items-center justify-content-between">
                    <span class="fw-bold">Arquivo criptografado (<code>.krypt</code>)</span>
                    <span class="font-monospace small text-body-secondary">Assinatura KRYPT1 v1</span>
                </div>
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div id="decryptDropzone" class="krypton-dropzone dropzone-amber p-4 p-md-5 text-center" role="button" tabindex="0" aria-label="Área para soltar arquivo .krypt ou clicar para selecionar">
                        <input type="file" id="decryptFileInput" name="EncryptedFile" accept=".krypt,application/octet-stream" class="d-none" required />
                        <div class="dropzone-icon-box" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <rect x="4" y="11" width="16" height="10" rx="2" />
                                <path d="M8 11V7a4 4 0 0 1 7.4-2" />
                            </svg>
                        </div>
                        <h2 class="h5 fw-bold mb-1" id="decryptDropzoneTitle">Solte o arquivo <code>.krypt</code> aqui</h2>
                        <p class="small text-body-secondary mx-auto mb-3" id="decryptDropzoneSubtitle">
                            O cabeçalho binário de 62 bytes e a tag GCM de cada bloco serão verificados antes da abertura
                        </p>
                        <button type="button" class="btn btn-sm btn-outline-secondary touch-target-btn px-4 fw-semibold" id="browseDecryptFileBtn">
                            Escolher arquivo .krypt
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card krypton-card mb-4">
                <div class="card-header bg-transparent border-bottom py-3 px-4">
                    <span class="fw-bold">Senha de desbloqueio</span>
                </div>
                <div class="card-body p-4">
                    <div class="mb-2">
                        <label for="decryptPassword" class="form-label small fw-semibold">Senha utilizada na criptografia</label>
                        <div class="input-group">
                            <input type="password" asp-for="Password" id="decryptPassword" class="form-control font-monospace"
                                   placeholder="Digite a senha do arquivo..." autocomplete="current-password" aria-describedby="decryptPasswordHelp" required />
                            <button type="button" class="btn btn-outline-secondary toggle-password-btn touch-target-btn" data-target="decryptPassword" aria-label="Mostrar ou ocultar senha">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg>
                            </button>
                        </div>
                        <div id="decryptPasswordHelp" class="form-text small mt-2">
                            Se a senha estiver incorreta ou qualquer byte tiver sido modificado, a validação GCM abortará a restauração.
                        </div>
                    </div>
                </div>
            </div>

            <div id="decryptAlertContainer" role="region" aria-live="polite"></div>

            <div id="decryptProgressCard" class="card krypton-card mb-3 d-none">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between small fw-semibold mb-2">
                        <span>Validando tags GCM e reconstruindo arquivo original...</span>
                        <span class="font-monospace">Processando</span>
                    </div>
                    <div class="progress" style="height: 5px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" style="width: 100%"></div>
                    </div>
                </div>
            </div>

            <button type="submit" id="submitDecryptBtn" class="btn-krypton-secondary w-100 py-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 7.4-2" />
                </svg>
                <span>Descriptografar e restaurar original</span>
            </button>
        </div>
    </div>
</form>
