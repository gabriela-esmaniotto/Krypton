@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="container py-5">
    <div class="card krypton-card border-danger shadow-sm mx-auto" style="max-width: 640px;">
        <div class="card-body p-4 text-center">
            <div class="text-danger mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                </svg>
            </div>
            <h2 class="h4 fw-bold text-danger">Ocorreu um erro durante a operação</h2>
            <p class="text-body-secondary mb-3">
                @(Model.ErrorMessage ?? "Não foi possível concluir a requisição solicitada.")
            </p>
            @if (Model.ShowRequestId)
            {
                <p class="small font-monospace text-body-secondary">
                    Request ID: <code>@Model.RequestId</code>
                </p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Voltar ao Painel Inicial</a>
        </div>
    </div>
</div>
